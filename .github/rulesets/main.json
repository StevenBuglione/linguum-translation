{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "required_linear_history"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {"context": "PR / Architecture and protected files"},
          {"context": "PR / Formatting, compiler, Detekt"},
          {"context": "PR / API and ABI compatibility"},
          {"context": "PR / Kotlin common and JVM tests"},
          {"context": "PR / Windows native and JVM integration"},
          {"context": "PR / Linux x64 native and JVM integration"},
          {"context": "PR / macOS native and JVM integration"},
          {"context": "PR / Android build and emulator integration"},
          {"context": "PR / iOS build and simulator integration"},
          {"context": "PR / Consumer fixtures Kotlin and Java"},
          {"context": "PR / Consumer fixture Swift"},
          {"context": "PR / Native safety smoke"},
          {"context": "PR / Model manifest and canary pairs"},
          {"context": "PR / License, dependency, SBOM smoke"},
          {"context": "PR / Artifact integrity and publication smoke"}
        ]
      }
    }
  ]
}
